# Public URLs registered in Meta App Dashboard
FRONTEND_URL=https://crm.example.com
PUBLIC_API_URL=https://api.example.com
META_REDIRECT_URI=https://api.example.com/api/v1/meta/callback

# From Meta for Developers → Your App → App Settings
META_APP_ID=
META_APP_SECRET=
# Choose a long, random value and enter the same value in Meta Webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Keep the version explicit so it can be upgraded deliberately.
META_GRAPH_VERSION=v27.0
